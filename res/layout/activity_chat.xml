<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_glow">

        <!-- barra sessione -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_header"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/back"
                style="@style/PipButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="‹"
                android:textColor="@color/accent"
                android:textSize="26sp" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_asi"
                android:tint="@color/accent"
                android:alpha="0.9"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    style="@style/PipHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sessions" />

                <TextView
                    android:id="@+id/sub"
                    style="@style/PipSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="" />
            </LinearLayout>

            <TextView
                android:id="@+id/stop"
                style="@style/PipButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_fab_dim"
                android:text="@string/stop"
                android:textColor="@color/danger"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/overflow"
                style="@style/PipButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:text="⋮"
                android:textSize="20sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:clipToPadding="false"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:scrollbars="none"
                android:transcriptMode="normal" />

            <TextView
                android:id="@+id/scroll_bottom"
                style="@style/PipButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_fab"
                android:elevation="4dp"
                android:text="↓"
                android:textColor="@color/on_accent"
                android:textSize="18sp"
                android:visibility="gone" />
        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/chips_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- riga allegati -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/emoji"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_fab_dim"
                android:gravity="center"
                android:tag="nofont"
                android:text="☺"
                android:textColor="@color/accent"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/pick_image"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_fab_dim"
                android:gravity="center"
                android:tag="nofont"
                android:text="🖼"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/pick_file"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_fab_dim"
                android:gravity="center"
                android:tag="nofont"
                android:text="📎"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- riga di input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:background="@drawable/bg_input_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="monospace"
                    android:text=">"
                    android:textColor="@color/accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/hint_message"
                    android:textColorHint="@color/text_faint"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:maxLines="6"
                    android:minHeight="42dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:scrollbars="vertical"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <TextView
                android:id="@+id/send"
                style="@style/PipButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_fab"
                android:text="↑"
                android:textColor="@color/on_accent"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <com.cyberstrike.client.ui.CrtOverlay
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
